rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Permitir leitura pública para que as fotos apareçam no cardápio
      allow read: if true;
      
      // Apenas Admin pode fazer upload/delete
      // Usamos a mesma lógica de Admin do Firestore, mas aqui no Storage 
      allow write: if request.auth != null && (
        request.auth.token.email == 'admin@talita.com' || 
        firestore.exists(/databases/(default)/documents/user_roles/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/user_roles/$(request.auth.uid)).data.role == 'admin'
      );
    }
  }
}
