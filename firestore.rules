rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares para legibilidade
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Produtos: Público pode ler, apenas Admin altera
    match /products/{productId} {
      allow read: if resource.data.available == true || isAdmin();
      allow write: if isAdmin();
    }

    // 2. Pedidos: 
    // - Qualquer um pode criar (para pedidos sem login)
    // - Cliente logado vê apenas os seus
    // - Admin vê tudo
    // - Público pode ler via ID (tracking secreto via UUID)
    match /orders/{orderId} {
      allow create: if true; 
      allow read: if isAdmin() || 
                     (resource.data.user_id != null && isOwner(resource.data.user_id)) ||
                     true; // Mantendo true para permitir tracking por ID (UUID)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 3. Itens do Pedido:
    // - Segue a lógica de acesso do pedido pai
    match /order_items/{itemId} {
      allow create: if true;
      allow read: if true; // No Firestore NoSQL, o acesso é via query filtrada no código
      allow write: if isAdmin();
    }

    // 4. Categorias: Público pode ler, apenas Admin altera
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Papéis de Usuário:
    // - Segurança máxima: Apenas o sistema ou o próprio usuário lê (Admin gerencia no console)
    match /user_roles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Alterações de admin devem ser feitas via Console ou Functions
    }
  }
}
